{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".opencode/skills", ".codex/skills"]
  },
  "mcp": {
    "ghidra": {
      "type": "local",
      "command": [
        "C:/Users/akspa/anaconda3/python.exe",
        "H:/ghidra_11.3.2_PUBLIC/GhidraMCP-release-1-4/bridge_mcp_ghidra.py",
        "--ghidra-server",
        "http://localhost:8080/"
      ],
      "environment": {},
      "enabled": true
    },

    "puppeteer": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "environment": {},
      "enabled": true
    },

    "x64dbg": {
      "type": "local",
      "command": [
        "C:/Users/akspa/AppData/Roaming/Python/Python314/Scripts/x64dbg-automate-mcp.exe"
      ],
      "environment": {
        "X64DBG_PATH": "C:\\x64dbg\\release\\x96dbg.exe"
      },
      "enabled": true
    }
  }
}
