{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ghidra": {
      "type": "local",
      "command": [
        "C:/Users/akspa/anaconda3/python.exe",
        "H:/ghidra_11.3.2_PUBLIC/GhidraMCP-release-1-4/bridge_mcp_ghidra.py",
        "--ghidra-server",
        "http://localhost:8080/"
      ],
      "environment": {},
      "enabled": true
    },

    "puppeteer": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "environment": {},
      "enabled": true
    },

    "x64dbg-mcp": {
      "type": "local",
      "command": [
        "C:/Users/akspa/anaconda3/python.exe",
        "-m",
        "x64dbg_mcp",
        "--stdio"
      ],
      "environment": {},
      "enabled": true
    }
  }
}
