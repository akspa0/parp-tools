<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\viewer\WoWViewer\Capture\VideoEncoderExecutableResolver.cs"
             Link="Capture\VideoEncoderExecutableResolver.cs" />
    <Compile Include="..\..\src\viewer\WoWViewer\Workbench\Services\Recording\RecordingModels.cs"
             Link="Recording\RecordingModels.cs" />
    <!-- Spec 280 UI documentation contract: the registry parser, the renderer and the
         control scanner are pure code, so the build check can reuse them verbatim. -->
    <Compile Include="..\..\src\viewer\WoWViewer\UI\UiReferenceDocument.cs"
             Link="UI\UiReferenceDocument.cs" />
    <Compile Include="..\..\src\viewer\WoWViewer\UI\UiControlScanner.cs"
             Link="UI\UiControlScanner.cs" />
    <Compile Include="..\..\src\viewer\WoWViewer\Workbench\Services\UiManager\UiLayout.cs"
             Link="UI\UiLayout.cs" />
    <!-- Spec 286 U0: footer fit and diagnostics projection are pure, so the headless tests
         exercise the same policy the viewer draws with. -->
    <Compile Include="..\..\src\viewer\WoWViewer\Workbench\Services\UiManager\ViewerFooterLayout.cs"
             Link="UI\ViewerFooterLayout.cs" />
    <Compile Include="..\..\src\viewer\WoWViewer\Workbench\Services\MinimapStatus\FooterDiagnosticsSnapshot.cs"
             Link="UI\FooterDiagnosticsSnapshot.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\core\WowViewer.Core\WowViewer.Core.csproj" />
    <ProjectReference Include="..\..\src\core\WowViewer.Core.IO\WowViewer.Core.IO.csproj" />
    <ProjectReference Include="..\..\src\core\WowViewer.Core.Runtime\WowViewer.Core.Runtime.csproj" />
    <ProjectReference Include="..\..\src\core\WowViewer.Core.Renderer\WowViewer.Core.Renderer.csproj" />
    <ProjectReference Include="..\..\tools\validation-capture\WowViewer.Tool.ValidationCapture\WowViewer.Tool.ValidationCapture.csproj" />
  </ItemGroup>

</Project>
