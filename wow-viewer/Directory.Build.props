<Project>
  <!-- MSBuild evaluates Exists() relative to the importing project's directory, so a
       bare relative path silently skips this import for every project under src/.
       Anchor it to this file's directory so all projects share one version source. -->
  <Import Project="$(MSBuildThisFileDirectory)eng\Version.props"
          Condition="Exists('$(MSBuildThisFileDirectory)eng\Version.props')" />

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <LangVersion>preview</LangVersion>
    <Company>akspa0</Company>
    <Product>WowViewer</Product>
    <Authors>akspa0</Authors>
    <RepositoryUrl>https://github.com/akspa0/wow-viewer</RepositoryUrl>
  </PropertyGroup>
</Project>
