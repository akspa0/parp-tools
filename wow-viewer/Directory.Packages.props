<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Vendored/forked third-party libraries under libs/ (several are git submodules pointing
       at pristine upstream commits, never to be edited directly) manage their own package
       versions and must opt out of central management here rather than in their own files. -->
  <PropertyGroup Condition="$(MSBuildProjectFullPath.Contains('libs\WoW-Tools\SereniaBLPLib')) Or $(MSBuildProjectFullPath.Contains('libs/WoW-Tools/SereniaBLPLib')) Or $(MSBuildProjectFullPath.Contains('libs\wowdev\DBCD')) Or $(MSBuildProjectFullPath.Contains('libs/wowdev/DBCD')) Or $(MSBuildProjectFullPath.Contains('libs\ModernWoWTools\Warcraft.NET')) Or $(MSBuildProjectFullPath.Contains('libs/ModernWoWTools/Warcraft.NET'))">
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="BCnEncoder.Net" Version="2.1.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="DBDefsLib" Version="1.0.1" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
    <PackageVersion Include="MeltySynth" Version="2.4.1" />
    <PackageVersion Include="NLayer" Version="2.0.1" />
    <PackageVersion Include="NVorbis" Version="0.10.5" />
    <PackageVersion Include="Silk.NET" Version="2.21.0" />
    <PackageVersion Include="Silk.NET.Input" Version="2.21.0" />
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.21.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageVersion Include="Silk.NET.OpenGL" Version="2.21.0" />
    <PackageVersion Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.21.0" />
    <PackageVersion Include="Silk.NET.Windowing" Version="2.21.0" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="SharpGLTF.Toolkit" Version="1.0.2" />
    <PackageVersion Include="Parquet.Net" Version="4.5.1" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
