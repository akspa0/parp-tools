{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v60-object-sieve-control-manifest.schema.json",
  "title": "V60 Object Sieve Control Manifest",
  "type": "object",
  "required": ["schema", "signal_contract", "row_count", "rows"],
  "properties": {
    "schema": { "const": "v60-object-sieve-control-v1" },
    "source_policy": { "const": "procedural_control_only" },
    "generator": { "type": "string", "minLength": 1 },
    "signal_contract": {
      "const": [
        "objectified_terrain_shadow_256",
        "terrain_shadow_256",
        "object_contamination_mask_256"
      ]
    },
    "row_count": { "type": "integer", "minimum": 1 },
    "families": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "placement_regimes": {
      "type": "array",
      "items": { "enum": ["none", "sparse", "dense", "overlap", "boundary_crossing"] },
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "row_id",
          "terrain_control_row_id",
          "object_family",
          "placement_regime",
          "input",
          "targets",
          "split",
          "placement_metadata",
          "npz"
        ],
        "properties": {
          "row_id": { "type": "string", "minLength": 1 },
          "terrain_control_row_id": { "type": "string", "minLength": 1 },
          "object_family": { "type": "string", "minLength": 1 },
          "placement_regime": {
            "enum": ["none", "sparse", "dense", "overlap", "boundary_crossing"]
          },
          "input": { "const": "objectified_terrain_shadow_256" },
          "targets": {
            "const": ["terrain_shadow_256", "object_contamination_mask_256"]
          },
          "split": { "enum": ["train", "validation", "test"] },
          "placement_metadata": { "type": "object" },
          "npz": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
