{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v50-cleanup-plan.schema.json",
  "title": "V50 Cleanup Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "plan_id", "inventory_identity", "release_manifest_identity",
    "approved_roots", "protected_artifact_ids", "targets", "expected_recovered_bytes",
    "dry_run_complete"
  ],
  "properties": {
    "schema": { "const": "v50-cleanup-plan-v1" },
    "plan_id": { "$ref": "#/$defs/hash" },
    "inventory_identity": { "$ref": "#/$defs/hash" },
    "release_manifest_identity": { "$ref": "#/$defs/hash" },
    "approved_roots": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "protected_artifact_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/hash" }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id", "resolved_path", "kind", "observed_identity", "observed_bytes",
          "replacement_proof", "dependency_check", "approved"
        ],
        "properties": {
          "artifact_id": { "$ref": "#/$defs/hash" },
          "resolved_path": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "observed_identity": { "$ref": "#/$defs/hash" },
          "observed_bytes": { "type": "integer", "minimum": 0 },
          "replacement_proof": { "type": "string", "minLength": 1 },
          "dependency_check": { "const": "pass" },
          "approved": { "const": true }
        }
      }
    },
    "expected_recovered_bytes": { "type": "integer", "minimum": 0 },
    "dry_run_complete": { "const": true }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
