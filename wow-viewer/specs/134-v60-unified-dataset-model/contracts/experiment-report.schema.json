{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v60-experiment-report.schema.json",
  "title": "V60 Limited Reconstruction Experiment Report",
  "type": "object",
  "required": ["schema", "data_stage", "dataset_manifest", "training_row_count", "baseline", "metrics_by_family"],
  "properties": {
    "schema": { "const": "v60-experiment-report-v1" },
    "data_stage": { "enum": ["control", "tiny_transfer", "expanded_transfer"] },
    "dataset_manifest": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string" },
    "training_row_count": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "baseline": { "type": "object" },
    "metrics_by_family": { "type": "object" },
    "ambiguity": { "type": "object" },
    "transfer_gate": { "type": "object" }
  },
  "additionalProperties": true
}
