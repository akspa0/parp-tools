{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wow-viewer/specs/116/contracts/held-out-split.schema.json",
  "title": "v50-held-out-split-v1",
  "description": "Spatially-isolated held-out split manifest for Spec 116 US4. SC-005 requires verified_violation_count == 0.",
  "type": "object",
  "required": [
    "schema", "created_utc", "build_id", "store", "taxonomy_revision",
    "adjacency_rule", "buffer_rings", "seed", "split_counts",
    "verified_violation_count", "absolute_comparison_to_prior_invalid"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "v50-held-out-split-v1" },
    "created_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "build_id": { "type": "string", "minLength": 1 },
    "store": {
      "type": "object", "required": ["path", "sha256"], "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "taxonomy_revision": { "type": "string", "minLength": 1 },
    "adjacency_rule": { "type": "string", "const": "8-neighbour" },
    "buffer_rings": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "split_counts": {
      "type": "object", "required": ["train", "held_out"], "additionalProperties": false,
      "properties": {
        "train": { "type": "integer", "minimum": 0 },
        "held_out": { "type": "integer", "minimum": 0 }
      }
    },
    "verified_violation_count": { "type": "integer", "const": 0 },
    "absolute_comparison_to_prior_invalid": { "type": "boolean", "const": true },
    "baseline_requiring_rerun": { "type": "string", "minLength": 1 }
  }
}