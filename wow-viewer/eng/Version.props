<Project>
  <PropertyGroup>
    <!-- Single source of truth for all wow-viewer assembly versions.
         InformationalVersion carries the display prerelease tag; VersionSuffix
         also applies it to package versions. The
         .NET SDK appends "+<git-commit>" build metadata automatically. The viewer
         title bar and About box display this value with the build metadata trimmed,
         so it must match the release tag (v0.6.0.1 -> 0.6.0.1). -->
    <VersionPrefix>0.6.0.1</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <AssemblyVersion>0.6.0.1</AssemblyVersion>
    <FileVersion>0.6.0.1</FileVersion>
    <InformationalVersion>0.6.0.1</InformationalVersion>
  </PropertyGroup>
</Project>
