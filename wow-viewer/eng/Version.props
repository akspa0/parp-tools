<Project>
  <PropertyGroup>
    <!-- Single source of truth for all wow-viewer assembly versions.
         InformationalVersion may carry a prerelease tag (e.g. -rc1); the
         .NET SDK appends "+<git-commit>" build metadata automatically. -->
    <VersionPrefix>0.5.3.1</VersionPrefix>
    <AssemblyVersion>0.5.3.1</AssemblyVersion>
    <FileVersion>0.5.3.1</FileVersion>
    <InformationalVersion>0.5.3.1</InformationalVersion>
  </PropertyGroup>
</Project>
