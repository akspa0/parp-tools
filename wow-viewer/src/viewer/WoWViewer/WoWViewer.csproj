<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ParpToolsWoWViewer</AssemblyName>
    <RootNamespace>WoWViewer</RootNamespace>
    <Version>0.5.2</Version>
    <AssemblyVersion>0.5.2</AssemblyVersion>
    <FileVersion>0.5.2</FileVersion>
    <InformationalVersion>0.5.2</InformationalVersion>
    <Product>parp-tools WoW Viewer</Product>
    <Description>parp-tools WoW Viewer for WoW Alpha 0.5.3 through Cataclysm 4.0.0.11927</Description>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET" />
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.OpenAL" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
    <PackageReference Include="MeltySynth" />
    <PackageReference Include="NLayer" />
    <PackageReference Include="NVorbis" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SharpGLTF.Toolkit" />
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\core\WowViewer.Core.Runtime\WowViewer.Core.Runtime.csproj" />
    <ProjectReference Include="..\..\..\src\core\WowViewer.Core.IO\WowViewer.Core.IO.csproj" />
    <ProjectReference Include="..\..\..\src\core\WowViewer.Core.PM4\WowViewer.Core.PM4.csproj" />
    <ProjectReference Include="..\..\..\libs\WoW-Tools\SereniaBLPLib\SereniaBLPLib\SereniaBLPLib.csproj" GlobalPropertiesToRemove="ManagePackageVersionsCentrally" />
    <ProjectReference Include="..\..\..\libs\ModernWoWTools\Warcraft.NET\Warcraft.NET\Warcraft.NET.csproj" GlobalPropertiesToRemove="ManagePackageVersionsCentrally" />
    <ProjectReference Include="..\..\..\libs\WoW-Tools\GillijimProject\gillijimproject-csharp.csproj" />
    <ProjectReference Include="..\..\..\libs\wowdev\DBCD\DBCD\DBCD.csproj" GlobalPropertiesToRemove="ManagePackageVersionsCentrally" />
    <ProjectReference Include="..\..\..\libs\wowdev\DBCD\DBCD.IO\DBCD.IO.csproj" GlobalPropertiesToRemove="ManagePackageVersionsCentrally" />

  </ItemGroup>

  <!-- Silk.NET's native package keeps OpenAL Soft under runtimes/<rid>/native.
       AudioContext resolves the DLL by its canonical name, so also place the
       selected desktop backend beside the executable. -->
  <PropertyGroup>
    <OpenALSoftNativeRuntime Condition="'$(RuntimeIdentifier)' == 'win-x86'">win-x86</OpenALSoftNativeRuntime>
    <OpenALSoftNativeRuntime Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win-arm64</OpenALSoftNativeRuntime>
    <OpenALSoftNativeRuntime Condition="'$(OpenALSoftNativeRuntime)' == '' and '$(PlatformTarget)' == 'x86'">win-x86</OpenALSoftNativeRuntime>
    <OpenALSoftNativeRuntime Condition="'$(OpenALSoftNativeRuntime)' == '' and '$(PlatformTarget)' == 'ARM64'">win-arm64</OpenALSoftNativeRuntime>
    <OpenALSoftNativeRuntime Condition="'$(OpenALSoftNativeRuntime)' == ''">win-x64</OpenALSoftNativeRuntime>
  </PropertyGroup>

  <Target Name="CopyOpenALSoftNativeToAppRoot" AfterTargets="Build">
    <ItemGroup>
      <OpenALSoftNative Include="$(TargetDir)runtimes\$(OpenALSoftNativeRuntime)\native\soft_oal.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(OpenALSoftNative)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('%(OpenALSoftNative.Identity)')" />
    <Copy SourceFiles="@(OpenALSoftNative)" DestinationFiles="$(TargetDir)openal32.dll" SkipUnchangedFiles="true" Condition="Exists('%(OpenALSoftNative.Identity)')" />
  </Target>

  <Target Name="CopyOpenALSoftNativeToPublishRoot" AfterTargets="Publish">
    <ItemGroup>
      <OpenALSoftPublishedNative Include="$(PublishDir)runtimes\$(OpenALSoftNativeRuntime)\native\soft_oal.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(OpenALSoftPublishedNative)" DestinationFiles="$(PublishDir)soft_oal.dll" SkipUnchangedFiles="true" Condition="Exists('%(OpenALSoftPublishedNative.Identity)')" />
    <Copy SourceFiles="@(OpenALSoftPublishedNative)" DestinationFiles="$(PublishDir)openal32.dll" SkipUnchangedFiles="true" Condition="Exists('%(OpenALSoftPublishedNative.Identity)')" />
  </Target>

  <!-- Bundle WoWDBDefs definitions with the output (required for DBC parsing via DBCD) -->
  <ItemGroup>
    <Content Include="..\..\..\libs\wowdev\WoWDBDefs\definitions\**\*.dbd" Link="definitions\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- No StormLib needed — pure C# NativeMpqService handles all MPQ access -->

</Project>
